---
const { size = 26 } = Astro.props;
---
<span class="logo">
  <svg class="mark" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
    <rect width="32" height="32" rx="8" />
    <g>
      <line x1="8" y1="13" x2="8" y2="19" />
      <line x1="12" y1="9" x2="12" y2="23" />
      <line x1="16" y1="6.5" x2="16" y2="25.5" />
      <line x1="20" y1="10" x2="20" y2="22" />
      <line x1="24" y1="13.5" x2="24" y2="18.5" />
    </g>
  </svg>Sonaria
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-display); font-size: 24px; font-weight: 500; letter-spacing: -.02em; color: var(--text); }
  /* Equalizer mark: five sound bars in the lime square */
  .mark { flex: none; }
  .mark rect { fill: var(--accent); }
  .mark g { stroke: var(--bg); stroke-width: 2.6; stroke-linecap: round; }
</style>
