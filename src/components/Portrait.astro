---
// Black-and-white portrait, optionally with a name card.
import site from '../data/site.json';
const { nameCard = false } = Astro.props;
const p = site.person;
---
<figure class="portrait">
  <img src={p.photo} alt={`Portrait of ${p.name}`} width="800" height="800" loading="eager" />
  <span class="shade" aria-hidden="true"></span>
  {nameCard && (
    <figcaption class="namecard">
      <span class="stack"><strong>{p.name}</strong><span class="muted">{p.role}, Sonaria Ltd.</span></span>
      <span class="mono accent">Sofia · EU</span>
    </figcaption>
  )}
</figure>

<style>
  .portrait { position: relative; margin: 0; aspect-ratio: 4 / 5; width: 100%; max-width: 460px; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--line); isolation: isolate; }
  img { width: 100%; height: 100%; object-fit: cover; object-position: center 20%; }
  .shade { position: absolute; inset: 0; border-radius: var(--radius-lg); box-shadow: inset 0 0 36px 4px rgba(14, 15, 12, .35); }
  .namecard { position: absolute; left: 14px; right: 14px; bottom: 14px; background: rgba(23, 24, 20, .94); border: 1px solid var(--line); border-radius: 12px; padding: 14px 18px; display: flex; justify-content: space-between; align-items: center; gap: 16px; font-size: 15px; }
  .namecard .muted { font-size: 13px; }
  .namecard .mono { color: var(--accent); }
</style>
