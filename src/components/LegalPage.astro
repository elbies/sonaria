---
import Base from '../layouts/Base.astro';
const { title, description } = Astro.props;
---
<Base title={title} description={description}>
  <section class="wrap section legal">
    <span class="tag">Legal</span>
    <h1 class="title">{title}</h1>
    <div class="body"><slot /></div>
  </section>
</Base>

<style>
  .legal { max-width: 820px; display: flex; flex-direction: column; gap: 24px; }
  .body { color: var(--text-body); }
  .body :global(h2) { font-family: var(--font-display); font-size: 22px; color: var(--text); margin: 32px 0 8px; }
  .body :global(p) { margin: 0 0 14px; }
  .body :global(ul) { margin: 0 0 14px; padding-left: 20px; display: flex; flex-direction: column; gap: 6px; }
  .body :global(strong) { color: var(--text-soft); }
  /* Wide tables scroll inside their own box, never the page */
  .body :global(.table-wrap) { overflow-x: auto; margin: 0 0 14px; border: 1px solid var(--line); border-radius: var(--radius-sm); }
  .body :global(table) { width: 100%; min-width: 560px; border-collapse: collapse; font-size: 14px; line-height: 1.5; }
  .body :global(th), .body :global(td) { text-align: left; vertical-align: top; padding: 10px 12px; border-bottom: 1px solid var(--line); }
  .body :global(th) { font-family: var(--font-mono); font-size: 11px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .body :global(tr:last-child td) { border-bottom: 0; }
  .body :global(.version) { margin-top: 32px; font-size: 13px; color: var(--faint); }
</style>
